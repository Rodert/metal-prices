[Unit]
Description=Metal Prices Data Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/metal-prices
Environment="PATH=/opt/metal-prices/venv/bin"
Environment="DATABASE_PATH=/opt/metal-prices/data/metal_prices.db"
Environment="HOST=0.0.0.0"
Environment="PORT=5000"
ExecStart=/opt/metal-prices/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 server:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
